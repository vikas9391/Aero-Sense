DATABASE_URL=sqlite://aircraft_verification.db?mode=rwc
PORT=8080
HOST=0.0.0.0

# Optional. If unset, the server generates a random 256-bit secret on first
# run and saves it to backend/.jwt_secret (gitignored) for reuse on future
# restarts. Set this explicitly when running more than one backend instance
# behind a load balancer, so every instance signs/verifies with the same key.
#   JWT_SECRET=

NFC_MODE=mock
RUST_LOG=info,backend=debug

# Required. Credentials for the single platform Super Admin account,
# created automatically on first startup. Login uses Company Name =
# "Super Admin" together with this email and password. Choose a strong,
# unique password (min 8 characters) — never reuse the example below.
SUPER_ADMIN_EMAIL=you@yourcompany.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password

# Optional. Comma-separated list of frontend origins allowed to call this API,
# e.g. https://app.example.com,http://localhost:5173
# Defaults to localhost dev origins if unset. Never set this to "*" once the
# API is reachable from the public internet.
#   ALLOWED_ORIGINS=http://localhost:5173

# Optional, default false. When true, /api/verification/nfc honors the
# client-supplied `simulate_scenario` field to fabricate failure states for
# demos (still restricted to Company Admin accounts even when on). Leave
# unset/false in production — it lets requests write fabricated results into
# the verification audit log.
#   ALLOW_VERIFICATION_SIMULATION=false

# Optional, default false. When true AND the database has zero companies,
# seeds one fully-populated demo tenant on startup — "Skyline Aviation
# Group" with 4 users (one per role), 2 aircraft, 4 components, 4 NFC tags
# (DEMO-NFC-0001..0004), and 2 verified maintenance records — so a demo
# opens with real data instead of empty screens. Demo admin login:
# admin@skyline-demo.test / DemoPass123!. Never overwrites existing data
# and never touches the Super Admin account. Leave unset/false in
# production.
#   DEMO_SEED=false

# Optional. Throttles POST /api/auth/login per ip:email key so brute-forcing
# a password is rate limited rather than unbounded. Defaults to 5 attempts
# per 15-minute window if unset.
#   LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
#   LOGIN_RATE_LIMIT_WINDOW_SECS=900
