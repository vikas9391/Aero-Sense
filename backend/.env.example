# Neon PostgreSQL connection string. Never commit the real credential.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require
PORT=8080
HOST=0.0.0.0

# Set explicitly in production. If unset, a random secret is generated locally.
JWT_SECRET=

RUST_LOG=info,backend=debug

# Required. Platform Super Admin credentials.
SUPER_ADMIN_EMAIL=you@yourcompany.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password

# Comma-separated frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Keep disabled in production.
ALLOW_VERIFICATION_SIMULATION=false
DEMO_SEED=false

# Optional login throttling.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECS=900
