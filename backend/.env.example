DATABASE_URL=sqlite://aircraft_verification.db?mode=rwc
PORT=8080
HOST=0.0.0.0

# Optional. If unset, the server generates a random 256-bit secret on first
# run and saves it to backend/.jwt_secret (gitignored) for reuse on future
# restarts. Set this explicitly when running more than one backend instance
# behind a load balancer, so every instance signs/verifies with the same key.
#   JWT_SECRET=

RUST_LOG=info,backend=debug

# Required. Credentials for the single platform Super Admin account,
# created automatically on first startup. Login uses Company Name =
# "Super Admin" together with this email and password. Choose a strong,
# unique password (min 8 characters).
SUPER_ADMIN_EMAIL=you@yourcompany.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password

# Optional. Comma-separated list of frontend origins allowed to call this API.
# Defaults to localhost dev origins if unset.
#   ALLOWED_ORIGINS=http://localhost:5173

# Optional, default false. When true, /api/verification/nfc honors the
# client-supplied `simulate_scenario` field for admin-only test scenarios.
# Keep this disabled in production.
#   ALLOW_VERIFICATION_SIMULATION=false

# Optional, default false. When true AND the database has zero companies,
# seeds one fully-populated demo tenant with sample components and NFC tags.
# Leave unset/false in production.
#   DEMO_SEED=false

# Optional login throttling.
#   LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
#   LOGIN_RATE_LIMIT_WINDOW_SECS=900
